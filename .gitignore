node_modules/
dist/
playground-dist/
*.log
.DS_Store
test-results/
playwright-report/
.env*
!.env.example
# npm run dev's settings: the emulators (demo-darsi), so development never reaches the live project. No secrets.
!apps/web/.env.development
# The unit tests' and the e2e suite's settings, when they need any (public demo values, no secrets): CI has no .env.local.
!apps/web/.env.test
!apps/web/.env.e2e
# Compiled Cloud Functions (npm run build --prefix functions)
functions/lib/
# Firebase CLI and emulator state; service-account keys never belong in the repo
.firebase/
*-debug.log
firebase-export-*/
*service-account*.json
*-firebase-adminsdk-*.json
*.tsbuildinfo
trainings/

# Videos and light lessons from Lesson Studio (scripts/import-packs.mjs); `npm run seed` uploads them.
content/media/

# Logins for the demo organization (npm run demo-org): passwords, never committed.
.demo-org.local.json

# Functions secrets for the emulators (Paymob and Stripe test keys).
.secret.local

# The tutor eval's answers (scripts/tutor-eval.mjs).
scripts/tutor-eval.out.json

# The tutor agent (agent/): its Python environment and caches
agent/.venv/
__pycache__/
.pytest_cache/

# npm run local: the emulators' saved data and the local build
.emulator-data/
.emulator-tmp/
apps/web/dist-local/
firebase.local.json

# npm run deploy: firebase.json without its rebuild hooks, written for the length of a release (scripts/deploy.mjs)
firebase.deploy.json

# npm run e2e: the browser suite's own build (apps/web/playwright.config.ts), so apps/web/dist stays what a release uploads
apps/web/dist-e2e/
