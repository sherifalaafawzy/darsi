rules_version = '2';
// Locked: the original default bucket (darsi-f0685.firebasestorage.app, us-west1). The app stores files in the
// europe-west1 bucket `darsi-f0685` (firebase/storage.rules); nothing may be read from or written to this one.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} { allow read, write: if false; }
  }
}
