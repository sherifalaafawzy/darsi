rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Lesson media and kits are public (they are also served by Hosting).
    match /media/{path=**} { allow read: if true; allow write: if false; }
    match /kits/{path=**} { allow read: if true; allow write: if false; }

    // Course editor (TECHNICAL.md "Authored content"). The published unit JSON and catalog.json files are written only by
    // Cloud Functions (Admin SDK). Editors upload media: lesson videos, captions and kit files, within these limits.
    function isSuper() { return request.auth != null && request.auth.token.role == 'superadmin'; }
    function inOrgS(orgId) { return request.auth != null && request.auth.token.orgId == orgId; }
    function mediaOk() {
      return (request.resource.contentType == 'video/mp4' && request.resource.size <= 60 * 1024 * 1024)
        || (request.resource.contentType.matches('text/vtt.*') && request.resource.size <= 512 * 1024)
        || (request.resource.contentType.matches('application/pdf|application/vnd[.]openxmlformats-officedocument[.]presentationml[.]presentation')
            && request.resource.size <= 20 * 1024 * 1024);
    }
    // Public units: anyone reads them, guests included (they fetch without the Firebase SDK).
    match /content/{path=**} { allow read: if true; }
    match /content/media/{unitId}/{file} {
      allow create, update: if isSuper() && mediaOk();
      allow delete: if isSuper();
    }
    // Org units: only that org's members (and platform admins) read them; its admins upload media.
    match /orgs/{orgId}/{path=**} { allow read: if inOrgS(orgId) || isSuper(); }
    match /orgs/{orgId}/media/{unitId}/{file} {
      allow create, update: if (isSuper() || (inOrgS(orgId) && request.auth.token.role == 'orgAdmin')) && mediaOk();
      allow delete: if isSuper() || (inOrgS(orgId) && request.auth.token.role == 'orgAdmin');
    }
    // The org's logo (TECHNICAL.md "Organization branding"): shrunk on the admin's phone to ≤ 256 px before upload.
    match /orgs/{orgId}/brand/{file} {
      allow create, update: if (isSuper() || (inOrgS(orgId) && request.auth.token.role == 'orgAdmin'))
        && file.matches('logo-[a-z0-9]{6,32}[.](png|webp|jpg)')
        && request.resource.contentType.matches('image/(png|webp|jpeg)') && request.resource.size <= 100 * 1024;
      allow delete: if isSuper() || (inOrgS(orgId) && request.auth.token.role == 'orgAdmin');
    }
    // Project evidence by course: submissions/{orgId|"none"}/{uid}/{unitId}/{file} (lesson/ProjectView.tsx). Only the
    // person writes their own, into their own organization's folder; photos, PDFs, voice notes and short videos only
    // (no SVG, whose scripts would run when opened), at most 10 MB, with the names the app gives them (L2).
    // Readable by them, platform admins, their organization's admins, their own teacher, and university teachers a
    // platform admin gave access to that course (Firestore courseAccess/{uid}.units).
    function grantedS(unitId) {
      return request.auth != null && firestore.exists(/databases/(default)/documents/courseAccess/$(request.auth.uid))
        && unitId in firestore.get(/databases/(default)/documents/courseAccess/$(request.auth.uid)).data.units;
    }
    function evidenceOk() {
      return request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif|heic|heif)|application/pdf|video/mp4|audio/(mpeg|mp4|aac|x-m4a|m4a|ogg|opus|webm|wav|x-wav|wave|3gpp|3gpp2|amr|flac)');
    }
    function ownFolder(orgId, uid) {
      return request.auth != null && request.auth.uid == uid && orgId == request.auth.token.get('orgId', 'none');
    }
    function teacherOfS(uid) {
      return request.auth.token.role == 'teacher'
        && firestore.get(/databases/(default)/documents/users/$(uid)).data.get('teacherId', null) == request.auth.uid;
    }
    function staffS(orgId, uid) {
      return request.auth.token.role == 'superadmin'
        || (request.auth.token.get('orgId', null) == orgId && (request.auth.token.role == 'orgAdmin' || teacherOfS(uid)));
    }
    match /submissions/{orgId}/{uid}/{unitId}/{file} {
      allow read: if request.auth != null && (request.auth.uid == uid || staffS(orgId, uid) || grantedS(unitId));
      allow create: if ownFolder(orgId, uid) && evidenceOk()
        && unitId.matches('[a-z0-9][a-z0-9-]{1,63}') && file.matches('[a-z0-9][a-z0-9-]{1,99}-[0-9]{10,16}-[A-Za-z0-9_.-]{1,240}');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    // Problem reports' screenshots (TECHNICAL.md "Problem reports"): written only by the reportBug function; platform
    // admins alone read them.
    match /bugReports/{file} { allow read: if isSuper(); allow write: if false; }
    // Project evidence from app versions before course folders: submissions/{orgId|"none"}/{uid}/{file}.
    match /submissions/{orgId}/{uid}/{file} {
      allow read: if request.auth != null && (request.auth.uid == uid || staffS(orgId, uid));
      allow create: if ownFolder(orgId, uid) && evidenceOk() && file.matches('[A-Za-z0-9_.-]{1,240}');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
