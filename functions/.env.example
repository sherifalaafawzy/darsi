# The functions' settings for one Firebase project. Copy to functions/.env.<project id> (for the live project:
# functions/.env.darsi-f0685; gitignored) and fill in. `npm run deploy` refuses to release functions without that file:
# a deploy that cannot ask questions stops when any of these has no value, defaults or not.
# No secrets here. The secrets live in Secret Manager (docs/FIREBASE.md §9): PAYMOB_SECRET_KEY, PAYMOB_HMAC_SECRET,
# STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, GEMINI_API_KEY, GITHUB_TOKEN ("unset" keeps a feature closed), and SSO_KEYS
# (school sign-in's key ring, JSON {"current":"k1","keys":{"k1":"<32 random bytes, base64>"}}; "unset" keeps it closed).
# The emulators use functions/.env.local and functions/.secret.local instead, which `npm run local` writes.

# Paymob: the public key and the integration ids of the payment methods (comma-separated), from the Paymob dashboard.
PAYMOB_PUBLIC_KEY=pk_example_0000000000
PAYMOB_INTEGRATIONS=1234567,7654321
# Where the payment providers answer. Change these only to point at a stand-in (scripts/local/payments.mjs).
PAYMOB_BASE=https://accept.paymob.com
STRIPE_BASE=https://api.stripe.com
# Where people return to after paying, and the links in emails: the site's public address, no trailing slash.
SITE_URL=https://example.org
# School sign-in (TECHNICAL.md "School sign-in"). Each organization registers <SSO_CALLBACK>/<its org id> at its
# provider: the second Hosting site (target "login", login.darsiai.org) serves the callback.
SSO_CALLBACK=https://login.darsiai.org/callback
# The service account the four sign-in functions run as (docs/FIREBASE.md): it alone reads SSO_KEYS and signs tokens.
# Empty: the project's default account (the emulators).
SSO_SERVICE_ACCOUNT=darsi-sso@darsi-f0685.iam.gserviceaccount.com
# Warm instances of the callback for a school day's first sign-ins (0: nothing paid while nobody signs in).
SSO_CALLBACK_MIN_INSTANCES=0
