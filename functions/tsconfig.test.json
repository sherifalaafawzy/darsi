{
  // The tests' own type-check: `npm run build` compiles src only, and vitest strips types without checking them.
  // npx tsc --noEmit -p tsconfig.test.json (scripts/verify.mjs runs it: a type error fails the run).
  // Bundler resolution, as vitest resolves: the tests import "../src/x" with no extension, which NodeNext refuses.
  "extends": "./tsconfig.json",
  "compilerOptions": { "noEmit": true, "rootDir": ".", "sourceMap": false, "module": "ESNext", "moduleResolution": "Bundler" },
  "include": ["src", "test"]
}
