# The browser suite's settings (npm run e2e builds with `vite build --mode e2e`; apps/web/playwright.config.ts).
# Committed on purpose (see the root .gitignore): public demo values, no secrets, so the suite runs the same on a
# machine with no .env.local (CI) as on the maintainer's, and never builds the live project's settings into a test.
# This file outranks .env.local in e2e mode, so it sets every setting .env.example lists: none falls through.
# The values are .env.development's, with the emulators off: the suite runs no emulators. It answers the app's Cloud
# Storage requests itself (e2e/storage.ts stands in for firebasestorage.googleapis.com, whatever the bucket's name),
# and nothing in it signs in.
VITE_FIREBASE_API_KEY=demo-local
VITE_FIREBASE_AUTH_DOMAIN=demo-darsi.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-darsi
VITE_FIREBASE_STORAGE_BUCKET=demo-darsi.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:local
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FUNCTIONS_REGION=europe-west1
VITE_USE_EMULATORS=false
# Push needs a real project's Web Push key, so it stays off here (Me says notifications are not set up).
VITE_FIREBASE_VAPID_KEY=
# Nothing listens here: only a signed-in Super account opens the relay, and the suite has none.
VITE_TUTOR_RELAY=ws://localhost:8091/live
