p"}]}]}]}},"trace-loop":{"id":"s1","template":"canvas","narration":{"en":"Python runs one line at a time. First it makes the list of marks, and total starts at zero. Each time round the loop, m takes the next mark and total grows: seven, then twelve, then twenty-one. When the marks run out, it prints the total.","ar":"ينفّذ بايثون سطرًا واحدًا في كل مرة. أولًا ينشئ قائمة الدرجات، ويبدأ المجموع total من الصفر. في كل دورة يأخذ m الدرجة التالية ويكبر المجموع: سبعة، ثم اثنا عشر، ثم واحد وعشرون. وعندما تنتهي الدرجات، يطبع المجموع."},"content":{"elements":[{"id":"h","type":"text","x":60,"y":90,"w":600,"size":44,"weight":800,"text":{"en":"Python runs one line at a time","ar":"ينفّذ بايثون سطرًا في كل مرة"}},{"id":"code","x":60,"y":280,"w":600,"h":900,"type":"trace","code":"marks = [7, 5, 9]\ntotal = 0\nfor m in marks:\n    total = total + m\nprint(total)","steps":[{"line":1,"vars":{"marks":"[7, 5, 9]"}},{"line":2,"vars":{"marks":"[7, 5, 9]","total":"0"}},{"line":3,"vars":{"marks":"[7, 5, 9]","total":"0","m":"7"}},{"line":4,"vars":{"marks":"[7, 5, 9]","total":"7","m":"7"}},{"line":3,"vars":{"marks":"[7, 5, 9]","total":"7","m":"5"}},{"line":4,"vars":{"marks":"[7, 5, 9]","total":"12","m":"5"}},{"line":3,"vars":{"marks":"[7, 5, 9]","total":"12","m":"9"}},{"line":4,"vars":{"marks":"[7, 5, 9]","total":"21","m":"9"}},{"line":3,"vars":{"marks":"[7, 5, 9]","total":"21","m":"9"}},{"line":5,"vars":{"marks":"[7, 5, 9]","total":"21","m":"9"},"out":3}],"output":"21\n","labels":{"vars":{"en":"Variables","ar":"المتغيرات"},"out":{"en":"Output","ar":"المخرجات"}},"anim":[{"prop":"reveal","keys":[{"at":0.4,"value":0},{"at":11.4,"value":1,"ease":"linear"}]},{"prop":"frame","keys":[{"at":0.4,"value":0},{"at":1.9714285714285715,"value":1,"ease":"in-out"},{"at":3.5428571428571427,"value":2,"ease":"in-out"},{"at":5.114285714285715,"value":3,"ease":"in-out"},{"at":6.685714285714286,"value":5,"ease":"in-out"},{"at":8.257142857142858,"value":7,"ease":"in-out"},{"at":9.82857142857143,"value":8,"ease":