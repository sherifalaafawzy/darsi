ا، ثم ما يتسع بعدها: ستون نقطة. لكن المقاعد والكتب تملؤها تمامًا: خمس وستون."},"content":{"elements":[{"id":"title","type":"text","x":48,"y":60,"w":624,"size":44,"weight":800,"text":{"en":"Pack the truck","ar":"حمّل الشاحنة"}},{"id":"truck","x":48,"y":210,"w":624,"h":900,"type":"knapsack","items":[{"label":{"en":"Solar panels","ar":"ألواح شمسية"},"w":600,"v":42},{"label":{"en":"Desks","ar":"مقاعد"},"w":500,"v":33},{"label":{"en":"Books","ar":"كتب"},"w":500,"v":32},{"label":{"en":"Water filter","ar":"فلتر ماء"},"w":300,"v":15},{"label":{"en":"Footballs","ar":"كرات قدم"},"w":200,"v":8},{"label":{"en":"Chalk, paper","ar":"طباشير وورق"},"w":100,"v":3}],"cap":1000,"unit":{"en":"kg","ar":"كغ"},"vunit":{"en":"points","ar":"نقطة"},"per":100,"perLabel":{"en":"per 100 kg","ar":"لكل 100 كغ"},"frames":[{"in":"......","note":{"en":"1,000 kg of room: best value per kilo first","ar":"المساحة 1000 كغ: الأغلى قيمةً لكل كيلو أولًا"}},{"in":"n.....","note":{"en":"Solar panels: in, 400 kg left","ar":"ألواح شمسية: تدخل، يبقى 400 كغ"}},{"in":"ix....","note":{"en":"Desks: 500 kg, only 400 left","ar":"مقاعد: 500 كغ والباقي 400 فقط"}},{"in":"ixx...","note":{"en":"Books: 500 kg, only 400 left","ar":"كتب: 500 كغ والباقي 400 فقط"}},{"in":"ixxn..","note":{"en":"Water filter: in, 100 kg left","ar":"فلتر ماء: تدخل، يبقى 100 كغ"}},{"in":"ixxix.","note":{"en":"Footballs: 200 kg, only 100 left","ar":"كرات قدم: 200 كغ والباقي 100 فقط"}},{"in":"ixxixn","note":{"en":"Chalk, paper: in, 0 kg left","ar":"طباشير وورق: تدخل، يبقى 0 كغ"}},{"in":"i..i.i","note":{"en":"Greedy: 60 points","ar":"الطريقة الجشعة: 60 نقطة"}},{"in":".nn...","note":{"en":"The best load: 65 points","ar":"الأفضل: 65 نقطة"}}],"anim":[{"prop":"reveal","keys":[{"at":0.4,"value":0},{"at":11.4,"value":1,"ease":"linear"}]},{"prop":"frame","keys":[{"at":0.4,"value":0},{"at":4.066666666666666,"value":6,"ease":"linear"},{"at":7.733333333333333,"value":7,"ease":"step"},{"at":11.4,"value":8,"ease":"step"}]}]}]}},"iot-temperature":{"id":"s1","temp