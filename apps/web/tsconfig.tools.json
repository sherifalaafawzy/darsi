{
  // What tsconfig.json leaves out: the e2e suite, the rules tests and the tool configs, which nothing else type-checks.
  // npx tsc --noEmit -p tsconfig.tools.json (scripts/verify.mjs runs it: a type error fails the run).
  "extends": "./tsconfig.json",
  "compilerOptions": { "noEmit": true, "types": ["node", "vite/client", "vite-plugin-pwa/client", "vitest/globals"] },
  "include": ["e2e", "tests-rules", "playwright.config.ts", "playwright.signed.config.ts", "vitest.config.ts", "vitest.rules.config.ts"]
}
