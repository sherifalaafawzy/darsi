# `npm run dev` (Vite's development mode) talks to the local Firebase Emulator Suite (project demo-darsi), never to the
# live project: this file outranks .env.local in development mode, and production builds (npm run build, the e2e suite)
# and the unit tests still read .env.local. Committed on purpose (see the root .gitignore); it holds no secrets.
# Start the emulators first: `npm run local -- you@gmail.com`, or
# `npx firebase emulators:start --project demo-darsi --only auth,firestore,functions,storage`.
# Where another program holds port 8080 (Laragon's nginx on the maintainer's machine), the emulators run with
# `--config firebase.local.json` and Firestore listens on 8085: put VITE_FIRESTORE_EMULATOR_PORT=8085 in an
# apps/web/.env.development.local (gitignored).
VITE_FIREBASE_API_KEY=demo-local
VITE_FIREBASE_AUTH_DOMAIN=demo-darsi.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-darsi
VITE_FIREBASE_STORAGE_BUCKET=demo-darsi.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:local
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FUNCTIONS_REGION=europe-west1
VITE_USE_EMULATORS=true
# Push needs the live project's Web Push key, so it stays off here (Me says notifications are not set up).
VITE_FIREBASE_VAPID_KEY=
# The tutor's voice relay, run locally by `npm run local`.
VITE_TUTOR_RELAY=ws://localhost:8091/live
