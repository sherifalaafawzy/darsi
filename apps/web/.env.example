# Copy to .env.local and fill in from Firebase console → Project settings → Your apps → Web app.
# .env.local is the live project: production builds (npm run build, a Hosting deploy) read it. `npm run dev` reads
# .env.development instead (committed), which points at the Emulator Suite, so development never touches live data, and
# the browser suite (npm run e2e) reads .env.e2e (committed, demo values).
#
# A production build stops with a message naming the setting when one marked REQUIRED is empty, or when
# VITE_USE_EMULATORS is true (checkBuildEnv in vite.config.ts): an app built without them has no sign-in and no courses.

# REQUIRED. The web API key ("Browser key (auto created by Firebase)"). Public, but never delete it in the console:
# without it nobody can sign in.
VITE_FIREBASE_API_KEY=
# REQUIRED. Where sign-in pages are served from: the site's own address (darsiai.org), so the Google window opens
# /__/auth/handler on it.
VITE_FIREBASE_AUTH_DOMAIN=
# REQUIRED. The Firebase project (Firestore, Auth, Functions).
VITE_FIREBASE_PROJECT_ID=
# REQUIRED. The Cloud Storage bucket courses, media and uploads live in (the europe-west1 bucket, not a default one).
VITE_FIREBASE_STORAGE_BUCKET=
# The project number: Cloud Messaging's sender (push notifications).
VITE_FIREBASE_MESSAGING_SENDER_ID=
# REQUIRED. The web app's id in the project.
VITE_FIREBASE_APP_ID=
# Google Analytics' measurement id, when the project has one. The app counts usage itself and never loads Google's SDK.
VITE_FIREBASE_MEASUREMENT_ID=
# REQUIRED. Push notifications: Project settings → Cloud Messaging → Web Push certificates → Generate key pair; paste the
# public key. Without it the app shows "notifications are not set up yet" instead of the switch.
VITE_FIREBASE_VAPID_KEY=
# Cloud Functions region (must match functions/src/index.ts setGlobalOptions).
VITE_FUNCTIONS_REGION=europe-west1
# true = use the local Firebase Emulator Suite (npm run local, or
# npx firebase emulators:start --project demo-darsi) instead of the real project. Must be false in a production build.
VITE_USE_EMULATORS=false
# REQUIRED. The tutor's voice relay (docs/FIREBASE.md §9), e.g. wss://<service>.run.app/live. Without it the tutor
# cannot talk.
VITE_TUTOR_RELAY=

# Not settings of the app (no VITE_ prefix; give them in the shell, not in a .env file):
#   DARSI_BUILD=<name>       the build's name in usage figures and problem reports (npm run deploy sets it to
#                            <commit>-<yyyymmdd>; without it the build takes the commit and today's date itself).
#   DARSI_LOCAL_BUILD=1      a production-mode build meant for the emulators (npm run local sets it): skips the check above.
