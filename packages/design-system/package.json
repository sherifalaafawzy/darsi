{
  "name": "@darsi/design-system",
  "version": "0.1.0",
  "description": "Darsi (درسي) design system — tokens, fonts, icons and RTL-ready React components for an offline-first teacher-upskilling PWA.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.js",
      "require": "./dist/tokens/index.cjs"
    },
    "./tokens.json": "./dist/tokens.json",
    "./tokens.css": "./dist/tokens.css",
    "./components.css": "./dist/components.css",
    "./styles.css": "./dist/styles.css",
    "./tailwind-preset": "./dist/tailwind-preset.cjs",
    "./fonts/*": "./dist/fonts/*",
    "./icons/*": "./dist/icons/*",
    "./logos/*": "./dist/logos/*",
    "./app-icons/*": "./dist/app-icons/*",
    "./pwa/*": "./dist/pwa/*"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "build": "npm run tokens && tsup && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsup --watch",
    "contrast": "node scripts/check-contrast.mjs",
    "playground": "npm run build && vite playground"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}